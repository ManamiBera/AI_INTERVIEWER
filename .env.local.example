# Copy this file to ".env.local" and fill in your own values.

# ---- Supabase (public — safe to expose to the browser) ----
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# ---- Google Gemini (server-only, optional) ----
# Free key: https://aistudio.google.com/app/apikey
# Leave blank to use the built-in offline analysis engine.
GEMINI_API_KEY=
